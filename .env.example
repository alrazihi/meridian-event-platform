# Meridian Event Platform - Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_DB=meridian
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change-me-in-production

# Spring Datasource (used by backend)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/meridian
SPRING_DATASOURCE_USERNAME=meridian
SPRING_DATASOURCE_PASSWORD=change-me-in-production

# =============================================================================
# Kafka Configuration
# =============================================================================
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_CONSUMER_GROUP_ID=event-platform-service
SPRING_KAFKA_PRODUCER_TRANSACTION_ID_PREFIX=event-platform-tx

# Kafka Security (SASL/PLAIN)
# Set to SASL_PLAINTEXT in production with SASL enabled
SPRING_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
SPRING_KAFKA_SASL_MECHANISM=PLAIN
SPRING_KAFKA_SASL_JAAS_CONFIG=

# =============================================================================
# JWT Authentication
# =============================================================================
# Option 1: JWK Set URI (recommended for production)
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=https://your-auth-server/.well-known/jwks.json

# Option 2: Public Key (base64-encoded PEM)
# JWT_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0K...

# =============================================================================
# CORS Configuration
# =============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Kafka Connect / Debezium
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=meridian
DB_PASSWORD=change-me-in-production
DB_NAME=meridian

# Kafka Connect authentication
KAFKA_CONNECT_PASSWORD=change-me-in-production

# Schema Registry authentication
SCHEMA_REGISTRY_PASSWORD=change-me-in-production

# Kafka UI authentication
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=change-me-in-production

# Kafka client credentials (for backend, connect, schema-registry, kafka-ui)
KAFKA_CLIENT_USERNAME=kafka-client
KAFKA_CLIENT_PASSWORD=change-me-in-production

# =============================================================================
# Audit Logging
# =============================================================================
AUDIT_HMAC_SECRET=change-me-in-production-use-strong-random-secret

# =============================================================================
# Spring Profiles
# =============================================================================
SPRING_PROFILES_ACTIVE=dev